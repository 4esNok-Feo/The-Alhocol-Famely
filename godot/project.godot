; ─────────────────────────────────────────────────────────────────────────
;  «Катьме: Смена» — проект Godot 4.3 (Compatibility, 2D-порт-срез).
;
;  Это дополнительный, а не основной вариант игры: браузерная версия живёт
;  в корне репозитория (index.html + src/). Godot-проект повторяет механику
;  смены на GDScript и нужен тем, кто хочет править игру в редакторе.
;
;  Как запустить: открыть папку godot/ в Godot 4.3 → F5.
;  Номера в конфиге (scripts/config.gd) синхронизированы с src/core/config.js.
; ─────────────────────────────────────────────────────────────────────────

config_version=5

[application]

config/name="Катьме: Смена"
config/description="Аркада о смене продавца в магазине «АЛОЕ&БЕЛОЕ». Расставьте товар, отбейте очередь, проверьте паспорта."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=1

