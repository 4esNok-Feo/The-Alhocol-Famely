{
  "name": "katme-smena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "«Катьме: Смена» — браузерная аркада о смене продавщицы в магазине «ВИНОГРАД» (HTML5, без сборщика)",
  "scripts": {
    "test": "node --test tests/*.test.js",
